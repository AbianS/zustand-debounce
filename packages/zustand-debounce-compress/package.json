{
  "name": "zustand-debounce-compress",
  "version": "2.0.1",
  "description": "Compression plugin for zustand-debounce - reduces storage size with LZ-based compression",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "repository": "https://github.com/AbianS/zustand-debounce",
  "homepage": "https://abians.github.io/zustand-debounce/",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --config tsup.config.ts --watch",
    "build": "tsup --config tsup.config.ts",
    "test": "jest",
    "test:cov": "jest --coverage",
    "size": "size-limit"
  },
  "keywords": [
    "zustand",
    "debounce",
    "zustand-debounce",
    "compression",
    "lz-string",
    "plugin"
  ],
  "author": "AbianS",
  "license": "MIT",
  "dependencies": {
    "lz-string": "1.5.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "14.3.0",
    "@types/jest": "30.0.0",
    "@types/lz-string": "1.5.0",
    "@types/node": "26.6.6",
    "jest": "30.5.2",
    "size-limit": "14.3.0",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "zustand-debounce": "workspace:*"
  },
  "peerDependencies": {
    "zustand-debounce": ">=3.0.0"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "5 KB"
    }
  ]
}
